generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model Organization {
  id           Int                    @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  address      String?
  status       OrgStatus              @default(TRIAL)
  createdAt    DateTime               @default(now())
  customers    Customer[]
  transactions InventoryTransaction[]
  payments     Payment[]
  products     Product[]
  sales        Sale[]
  users        User[]
}

model User {
  id             Int           @id @default(autoincrement())
  name           String
  email          String        @unique
  password       String
  role           UserRole
  organizationId Int?
  isActive       Boolean       @default(true)
  permissions    Json?         @default("[]")
  createdAt      DateTime      @default(now())
  sales          Sale[]
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "User_organizationId_fkey")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id             Int                    @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  barcode        String?
  categoryId     Int?
  supplier       String?
  buyingPrice    Decimal                @db.Decimal(10, 2)
  sellingPrice   Decimal                @db.Decimal(10, 2)
  quantity       Int                    @default(0)
  minimumStock   Int                    @default(0)
  image          String?
  status         ProductStatus          @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   InventoryTransaction[]
  category       Category?              @relation(fields: [categoryId], references: [id])
  organization   Organization           @relation(fields: [organizationId], references: [id])
  saleItems      SaleItem[]

  @@index([categoryId], map: "Product_categoryId_fkey")
  @@index([organizationId], map: "Product_organizationId_fkey")
}

model InventoryTransaction {
  id              Int             @id @default(autoincrement())
  organizationId  Int
  productId       Int
  type            TransactionType
  quantity        Int
  reason          String?
  referenceNumber String?
  notes           String?
  performedBy     String
  createdAt       DateTime        @default(now())
  organization    Organization    @relation(fields: [organizationId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])

  @@index([organizationId], map: "InventoryTransaction_organizationId_fkey")
  @@index([productId], map: "InventoryTransaction_productId_fkey")
}

model Customer {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  address        String?
  customerType   CustomerType @default(REGULAR)
  isWalkIn       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id])
  sales          Sale[]

  @@index([organizationId], map: "Customer_organizationId_fkey")
}

model Sale {
  id             Int           @id @default(autoincrement())
  organizationId Int
  customerId     Int?
  cashierId      Int
  receiptNumber  String
  subtotal       Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0.00) @db.Decimal(10, 2)
  tax            Decimal       @default(0.00) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PAID)
  saleStatus     SaleStatus    @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now())
  payments       Payment[]
  cashier        User          @relation(fields: [cashierId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  items          SaleItem[]

  @@index([cashierId], map: "Sale_cashierId_fkey")
  @@index([customerId], map: "Sale_customerId_fkey")
  @@index([organizationId], map: "Sale_organizationId_fkey")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0.00) @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])

  @@index([productId], map: "SaleItem_productId_fkey")
  @@index([saleId], map: "SaleItem_saleId_fkey")
}

model Payment {
  id             Int           @id @default(autoincrement())
  saleId         Int
  organizationId Int
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  reference      String?
  paidAt         DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  sale           Sale          @relation(fields: [saleId], references: [id])

  @@index([organizationId], map: "Payment_organizationId_fkey")
  @@index([saleId], map: "Payment_saleId_fkey")
}

model ScannerSession {
  token     String   @id
  orgId     Int
  barcode   String?
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum UserRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  ORGANIZATION_ADMIN
  CASHIER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  SALE
  RETURN
}

enum CustomerType {
  WALK_IN
  REGULAR
  WHOLESALE
  VIP
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
}
